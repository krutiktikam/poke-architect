{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "export:api": "python ../scripts/export_openapi.py",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:api": "git diff --exit-code src/api/schema.d.ts",
    "size": "size-limit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.15.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-app": "^14.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.9",
    "react-is": "^19.2.5",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12"
  }
}
